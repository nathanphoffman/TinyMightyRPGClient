generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  // Only the hash is stored; the raw token goes out in the reset email
  // and is never persisted, same principle as passwordHash.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  characters      Character[]
  campaignsRun    Campaign[]  @relation("CampaignGm")

  @@map("users")
}

model Character {
  id           String   @id @default(uuid())
  name         String
  level        Int      @default(1)

  physique     Int
  wits         Int
  charm        Int
  senses       Int

  backstory    String   @default("")

  hpCurrent    Int
  hpMax        Int

  attackBonus    Int    @default(0)
  defense        Int    @default(5)

  // Flexible list of items; kept as JSON rather than a separate table
  // since inventory shape is still evolving and always loaded/saved as a whole.
  inventory    Json     @default("[]")
  // Player-invented powers picked during character creation, same rationale as inventory.
  powers       Json     @default("[]")

  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  memberships  CampaignMember[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@map("characters")
}

model Campaign {
  id        String   @id @default(uuid())
  name      String
  gmId      String
  gm        User     @relation("CampaignGm", fields: [gmId], references: [id], onDelete: Cascade)

  members   CampaignMember[]

  createdAt DateTime @default(now())

  @@index([gmId])
  @@map("campaigns")
}

model CampaignMember {
  campaignId  String
  characterId String

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  joinedAt    DateTime  @default(now())

  @@id([campaignId, characterId])
  @@map("campaign_members")
}
